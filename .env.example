# Copy to `.env` (which is git-ignored) and adjust. Loaded by python-dotenv
# from config/settings.py.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Hosts the app answers on. cb.alma.local is the deployed name (nginx -> gunicorn),
# localhost/127.0.0.1 for direct access and the test scripts. Use * only for dev.
DJANGO_ALLOWED_HOSTS=cb.alma.local,localhost,127.0.0.1

# Database — PostgreSQL is the default (see docs/11-operations.md).
# Switch back with DB_ENGINE=django.db.backends.mysql (+ DB_PORT=3306).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pms_purchasing
DB_USER=pms_purchasing
DB_PASSWORD=pms_purchasing
DB_HOST=127.0.0.1
DB_PORT=5432

# Extra origins allowed to POST forms (comma separated).
# http://cb.alma.local must be there or every login/form POST is rejected 403.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8001,http://127.0.0.1:8001,http://cb.alma.local

# Active Directory bind account — REQUIRED for LDAP logins, never commit it.
# The local `admin` user works without it.
AUTH_LDAP_BIND_PASSWORD=
