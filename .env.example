# Copy to `.env` (which is git-ignored) and adjust. Loaded by python-dotenv
# from config/settings.py.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database — PostgreSQL is the default (see docs/11-operations.md).
# Switch back with DB_ENGINE=django.db.backends.mysql (+ DB_PORT=3306).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pms_purchasing
DB_USER=pms_purchasing
DB_PASSWORD=pms_purchasing
DB_HOST=127.0.0.1
DB_PORT=5432

# Extra origins allowed to POST forms (comma separated)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8001,http://127.0.0.1:8001

# Active Directory bind account — REQUIRED for LDAP logins, never commit it.
# The local `admin` user works without it.
AUTH_LDAP_BIND_PASSWORD=
